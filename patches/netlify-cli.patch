diff --git a/dist/commands/base-command.js b/dist/commands/base-command.js
index 83ded7f5709db6a50b1458a4ead218a9c7418ec6..1527002ed279671d88057ee5adea0ffcd1afb028 100644
--- a/dist/commands/base-command.js
+++ b/dist/commands/base-command.js
@@ -105,7 +105,16 @@ async function selectWorkspace(project, filter) {
     return selected.path;
 }
 async function getRepositoryRoot(cwd) {
-    const res = await findUp('.git', { cwd, type: 'directory' });
+    // The stock directory-only search walks past a git worktree's `.git`
+    // file since it is not a directory. If the worktree is in a subdir of
+    // another git repo it hits the main repo's checkout and serves from
+    // there rather than the worktree. Patch this line so it recognizes a
+    // dir or a file. Only `serve` (and therefore e2e tests) affects us
+    // since vite and config get passed directories explicitly.
+    // `utils/get-repo-data.js` is only used in deploys, not worktrees.
+    // There is a similar bug filed against `@netlify/config`:
+    // https://github.com/netlify/cli/issues/7868
+    const res = await findUp('.git', { cwd, type: 'both' });
     if (res) {
         return join(res, '..');
     }
diff --git a/dist/utils/proxy.js b/dist/utils/proxy.js
index fced1d1e451462e515fca39c8beb1301a264e32f..5d4341d913db63e5af0ef8b5ad638b040d17032d 100644
--- a/dist/utils/proxy.js
+++ b/dist/utils/proxy.js
@@ -587,7 +587,16 @@ const initializeProxy = async function ({ config, configPath, distDir, env, host
         web: (req, res, options) => {
             const requestURL = new URL(req.url, 'http://127.0.0.1');
             req.proxyOptions = options;
-            req.alternativePaths = alternativePathsFor(requestURL.pathname).map((filePath) => filePath + requestURL.search);
+            // The stock CLI replays 404/403 responses with `.html`/`.htm`/`/index.html`
+            // path spellings. With the SSR function mounted at /* each replay is a
+            // fresh render, multiplying every not-found page into many invocations -
+            // slow local 404s, long e2e runs, and function-host contention in CI.
+            // Skip the replays for function-routed requests; the fallback is
+            // CLI-only, so skipping matches production:
+            // https://answers.netlify.com/t/netlify-is-invoking-404-functions-4-extra-times/127098
+            req.alternativePaths = options?.headers?.[NFFunctionName]
+                ? []
+                : alternativePathsFor(requestURL.pathname).map((filePath) => filePath + requestURL.search);
             // Ref: https://nodejs.org/api/net.html#net_socket_remoteaddress
             req.headers['x-forwarded-for'] = req.connection.remoteAddress || '';
             proxy.web(req, res, options);
